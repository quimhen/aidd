+def wait_for_stable_inputs(capture, stable_seconds: float, timeout: float) -> dict[str, str]:
+    """Wait for identical input manifests for an uninterrupted bounded period."""
+    if not (math.isfinite(stable_seconds) and math.isfinite(timeout) and 0 <= stable_seconds <= timeout and timeout > 0):
+        raise ValueError('input stability must be nonnegative and at most a positive timeout')
+    start = time.monotonic()
+    previous = None
+    stable_since = start
+    while True:
+        now = time.monotonic()
+        if now - start > timeout:
+            raise TimeoutError('database inputs did not stabilize before timeout')
+        try:
+            current = capture()
+        except OSError:
+            previous = None
+            stable_since = time.monotonic()
+        else:
+            now = time.monotonic()
+            if now - start > timeout:
+                raise TimeoutError('database inputs did not stabilize before timeout')
+            if current != previous:
+                previous = current
+                stable_since = now
+            if stable_seconds == 0 or now - stable_since >= stable_seconds:
+                return current
+        remaining = timeout - (time.monotonic() - start)
+        if remaining <= 0:
+            raise TimeoutError('database inputs did not stabilize before timeout')
+        time.sleep(min(1.0, remaining))
+
